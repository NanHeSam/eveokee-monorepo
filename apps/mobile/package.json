{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "APP_VARIANT=development expo start",
    "dev:dev-client": "APP_VARIANT=development expo start --dev-client",
    "dev-ios-device": "APP_VARIANT=development expo run:ios --device",
    "dev-android-device": "APP_VARIANT=development expo run:android --device",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "build": "echo 'Mobile app builds via EAS, not local build'",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "dependencies": {
    "@backend/convex": "workspace:*",
    "@clerk/expo": "^4.6.6",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@sentry/react-native": "^7.11.0",
    "convex": "^1.45.0",
    "date-fns": "^4.4.0",
    "expo": "57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "^57.0.2",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "^57.0.18",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^4.71.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-css-interop": "^0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.9.1",
    "react-native-purchases-ui": "^10.9.1",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-track-player": "^5.0.0-alpha0",
    "react-native-video": "^6.19.2",
    "react-native-view-shot": "^5.1.0",
    "react-native-worklets": "^0.10.1",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sentry/cli": "^3.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
